# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4
max_line_length = 100

[*.{ttl,rq,sparql}]
indent_size = 4

[*.{yml,yaml,cff}]
indent_size = 2

[*.json]
indent_size = 2

[*.toml]
indent_size = 4

[*.md]
indent_size = 2
# Markdown gives two trailing spaces a meaning (a hard line break), so stripping
# them silently changes rendered output.
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

[.htaccess]
indent_size = 2

# --- Files that must not be reformatted -------------------------------------
#
# Third-party ontologies, redistributed unmodified. Some contain tabs and
# trailing whitespace; the evaluation in the paper was run against these exact
# bytes, and CI byte-compares regenerated output, so an editor tidying them up
# would break reproducibility rather than improve anything.
[examples/vendor/**]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = false

# Generated by scripts/build_figures.py and scripts/evaluate.py, and compared
# byte-for-byte by the `reproduce` CI job. Edit the generators, never these.
[{figures,results}/**]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = false
