digraph G {
  rankdir=LR;
  graph [fontname="Times", splines=true, overlap=false, nodesep=0.35];
  node  [fontname="Times", fontsize=10];
  edge  [fontname="Times", fontsize=9, labeldistance=1.6];
  "http://www.w3.org/2001/XMLSchema#date" [label="date", shape=box, style="filled", fillcolor="#FFCC33", color="#B38A00"];
  "http://www.w3.org/2001/XMLSchema#string" [label="string", shape=box, style="filled", fillcolor="#FFCC33", color="#B38A00"];
  "https://example.org/library#Author" [label="Author", shape=circle, style="filled", fillcolor="#AACCFF", color="#3366CC"];
  "https://example.org/library#Book" [label="Book", shape=circle, style="filled", fillcolor="#AACCFF", color="#3366CC"];
  "https://example.org/library#Journal" [label="Journal", shape=circle, style="filled", fillcolor="#AACCFF", color="#3366CC"];
  "https://example.org/library#Library" [label="Library", shape=circle, style="filled", fillcolor="#AACCFF", color="#3366CC"];
  "https://example.org/library#Member" [label="Member", shape=circle, style="filled", fillcolor="#AACCFF", color="#3366CC"];
  "https://example.org/library#Person" [label="Person", shape=circle, style="filled", fillcolor="#AACCFF", color="#3366CC"];
  "https://example.org/library#Publication" [label="Publication", shape=circle, style="filled", fillcolor="#AACCFF", color="#3366CC"];
  "https://example.org/library#birthDate" [label="birth date", shape=box, style="filled", fillcolor="#99CC66", color="#5C8A2E"];
  "https://example.org/library#borrows" [label="borrows", shape=box, style="filled", fillcolor="#AACCFF", color="#3366CC"];
  "https://example.org/library#hasAuthor" [label="has author", shape=box, style="filled", fillcolor="#AACCFF", color="#3366CC"];
  "https://example.org/library#heldBy" [label="«functional»\nheld by", shape=box, style="filled", fillcolor="#AACCFF", color="#3366CC"];
  "https://example.org/library#isbn" [label="«functional»\nisbn", shape=box, style="filled", fillcolor="#99CC66", color="#5C8A2E"];
  "https://example.org/library#issn" [label="issn", shape=box, style="filled", fillcolor="#99CC66", color="#5C8A2E"];
  "https://example.org/library#name" [label="name", shape=box, style="filled", fillcolor="#99CC66", color="#5C8A2E"];
  "https://example.org/library#title" [label="title", shape=box, style="filled", fillcolor="#99CC66", color="#5C8A2E"];
  "https://example.org/library#Author" -> "https://example.org/library#Person" [label="Subclass of", arrowhead=normal, style=dashed, color="#666666"];
  "https://example.org/library#Book" -> "https://example.org/library#Publication" [label="Subclass of", arrowhead=normal, style=dashed, color="#666666"];
  "https://example.org/library#Journal" -> "https://example.org/library#Publication" [label="Subclass of", arrowhead=normal, style=dashed, color="#666666"];
  "https://example.org/library#Member" -> "https://example.org/library#Person" [label="Subclass of", arrowhead=normal, style=dashed, color="#666666"];
  "https://example.org/library#Person" -> "https://example.org/library#birthDate" [arrowhead=none, color="#5C8A2E"];
  "https://example.org/library#birthDate" -> "http://www.w3.org/2001/XMLSchema#date" [arrowhead=normal, color="#5C8A2E"];
  "https://example.org/library#Member" -> "https://example.org/library#borrows" [arrowhead=none, color="#3366CC"];
  "https://example.org/library#borrows" -> "https://example.org/library#Book" [arrowhead=normal, color="#3366CC", headlabel="0..5"];
  "https://example.org/library#Publication" -> "https://example.org/library#hasAuthor" [arrowhead=none, color="#3366CC"];
  "https://example.org/library#hasAuthor" -> "https://example.org/library#Author" [arrowhead=normal, color="#3366CC", headlabel="1..*"];
  "https://example.org/library#Book" -> "https://example.org/library#heldBy" [arrowhead=none, color="#3366CC"];
  "https://example.org/library#heldBy" -> "https://example.org/library#Library" [arrowhead=normal, color="#3366CC"];
  "https://example.org/library#Book" -> "https://example.org/library#isbn" [arrowhead=none, color="#5C8A2E"];
  "https://example.org/library#isbn" -> "http://www.w3.org/2001/XMLSchema#string" [arrowhead=normal, color="#5C8A2E"];
  "https://example.org/library#Journal" -> "https://example.org/library#issn" [arrowhead=none, color="#5C8A2E"];
  "https://example.org/library#issn" -> "http://www.w3.org/2001/XMLSchema#string" [arrowhead=normal, color="#5C8A2E"];
  "https://example.org/library#Person" -> "https://example.org/library#name" [arrowhead=none, color="#5C8A2E"];
  "https://example.org/library#name" -> "http://www.w3.org/2001/XMLSchema#string" [arrowhead=normal, color="#5C8A2E"];
  "https://example.org/library#Publication" -> "https://example.org/library#title" [arrowhead=none, color="#5C8A2E"];
  "https://example.org/library#title" -> "http://www.w3.org/2001/XMLSchema#string" [arrowhead=normal, color="#5C8A2E"];
}
